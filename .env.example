VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set in Supabase Edge Function secrets, never expose in Vite:
# GEMINI_API_KEY=your-gemini-key
# Optional for evaluate-profile; its rule-based fallback works without it:
# ANTHROPIC_API_KEY=your-anthropic-key
# SUPABASE_SERVICE_ROLE_KEY is injected automatically by Supabase Edge Functions.

# Optional for scripts/import-universities.mjs (U.S. College Scorecard enrichment):
# COLLEGE_SCORECARD_API_KEY=your-data-gov-key
